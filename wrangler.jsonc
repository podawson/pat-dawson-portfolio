{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pat-dawson-portfolio",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
